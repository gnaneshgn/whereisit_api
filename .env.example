# ---------------------------------------------------------------
# Django
# ---------------------------------------------------------------
DJANGO_SECRET_KEY=
DEBUG=True
# Add your machine's LAN IP for physical devices, and 10.0.2.2 for the Android emulator.
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# Comma-separated. Leave empty with DEBUG=True to allow all origins in dev.
CORS_ALLOWED_ORIGINS=

# Leave empty for SQLite (db.sqlite3). Production example:
# DATABASE_URL=postgres://vizagmove:password@localhost:5432/vizagmove
DATABASE_URL=

# ---------------------------------------------------------------
# APSRTC feeds (reclaim.city)
# ---------------------------------------------------------------
APSRTC_VEHICLE_POSITIONS_URL=https://maps.reclaim.city/apsrtc/rt/vehicle_positions.json
APSRTC_TRIP_UPDATES_URL=https://maps.reclaim.city/apsrtc/rt/trip_updates.json
APSRTC_STATUS_URL=https://maps.reclaim.city/apsrtc/rt/status.json
APSRTC_GTFS_URL=https://maps.reclaim.city/gtfs/apsrtc.zip

# HTTP behaviour (seconds / attempts)
APSRTC_CONNECT_TIMEOUT=5
APSRTC_READ_TIMEOUT=30
APSRTC_MAX_RETRIES=2

# ---------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------
# Leave empty for local dev without Redis: Django uses a file-based cache
# and Celery uses the filesystem broker (both under backend/var/).
REDIS_URL=redis://localhost:6379/0
# Optional override; defaults to REDIS_URL (or the filesystem broker).
CELERY_BROKER_URL=

# Sync intervals (seconds). The upstream feed refreshes roughly every 60s.
BUS_SYNC_INTERVAL=30
TRIP_UPDATES_SYNC_INTERVAL=60
FEED_STATUS_CHECK_INTERVAL=60

# ---------------------------------------------------------------
# GPS freshness thresholds (seconds since the vehicle's own GPS timestamp)
# ---------------------------------------------------------------
GPS_LIVE_MAX_AGE=90
GPS_RECENT_MAX_AGE=300
GPS_DELAYED_MAX_AGE=1800
# Timestamps further than this in the future are treated as invalid.
GPS_FUTURE_TOLERANCE=120

# Feed-level health
FEED_STALE_AFTER=300
FEED_DOWN_AFTER=600
FEED_SYNC_LOG_RETENTION_DAYS=3

# Optional: restrict API results to a bounding box "min_lat,min_lon,max_lat,max_lon".
# Visakhapatnam example: 17.60,83.00,17.95,83.45   (empty = whole APSRTC network)
SERVICE_AREA_BBOX=

# Store each vehicle's raw upstream record in LiveBus.raw_data (debugging only).
STORE_RAW_VEHICLE_DATA=False
